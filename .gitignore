# ----------------------------------------------------------------- SPRITES
#
# NENHUM sprite de Pokemon entra neste repositorio. Nunca.
#
# Sao arte protegida da The Pokemon Company / Nintendo / Creatures / GAME FREAK.
# O app busca as imagens em runtime, no aparelho de quem ligou a fonte nos
# Ajustes — e por isso ele nao redistribui nada. Commitar os arquivos
# transformaria o repositorio em redistribuicao, que e coisa completamente
# diferente do ponto de vista legal.
#
# Sem imagem o app continua inteiro: cai no tile de monograma, que e o padrao de
# fabrica.
#
# ATENCAO: os `icon-*.png` e `apple-touch-icon.png` em apps/web/public sao
# versionados de proposito — sao arte PROPRIA (o monograma TK), geradas por
# `apps/web/scripts/make-icons.ts`. Nao confundir com sprite.
apps/web/public/sprites/
apps/web/public/pokemon/
**/sprites/pokemon/
*.sprite.png
sprites-cache/
packages/dataset/.cache/

# GAME_MASTER cru (18 MB). Reconstruivel pelo pipeline de ETL.
packages/dataset/raw/

# Leitor de texto (tesseract): wasm + modelo, ~5,9 MB. Mesmo caso do dataset —
# reconstruivel com `pnpm --filter @trainerkit/web ocr:fetch`, e um diff de
# binario a cada atualizacao do pacote nao serve pra ninguem.
apps/web/public/ocr/

# Fontes auto-hospedadas: 154 KB de woff2 reconstruivel por
# `pnpm --filter @trainerkit/web fontes`. Mesmo criterio do OCR e do dataset.
apps/web/public/fontes/

# Dataset gerado. Fora do git pelo mesmo motivo dos sprites: e dado do jogo,
# so que transformado. `pnpm --filter @trainerkit/dataset refresh` regenera em
# segundos, entao versionar so traria o incomodo de um diff de 1 MB a cada
# atualizacao do jogo.
apps/web/public/dataset/
.vercel

# Vinculo local do projeto Vercel (id do projeto e da org). Nao e segredo, mas e
# especifico da maquina e nao serve pra mais ninguem.
.vercel

# A Vercel instala a funcao com `npm install` (ver vercel.json), e o npm gera
# este arquivo. O lockfile de verdade do repo e o pnpm-lock.yaml — dois
# lockfiles no mesmo repo e a receita pra versoes divergirem sem ninguem ver.
package-lock.json

# Mockup do handoff servido localmente pra comparar lado a lado. Nao vai pro repo.
apps/web/public/_handoff/
