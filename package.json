{
  "name": "trainerkit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "publicar": "bash scripts/publicar.sh",
    "dev": "pnpm --filter @trainerkit/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.api.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  }
}
