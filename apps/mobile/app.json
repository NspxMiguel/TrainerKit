{
  "expo": {
    "name": "TrainerKit",
    "slug": "trainerkit",
    "version": "0.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "trainerkit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.trainerkit.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.trainerkit.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "./plugins/ios-assinatura",
      "./plugins/ios-build",
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TrainerKit lê o print da avaliação para calcular o IV. A imagem não sai do aparelho."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Modo Pokédex aponta a câmera para o que está à sua frente. Nada é enviado nem gravado."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "es-419": "./locales/es-419.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "ru": "./locales/ru.json"
    }
  }
}
