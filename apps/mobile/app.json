{
  "expo": {
    "name": "TrainerKit",
    "slug": "trainerkit",
    "version": "0.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "trainerkit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.trainerkit.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.trainerkit.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TrainerKit lê o print da avaliação para calcular o IV. A imagem não sai do aparelho."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Modo Pokédex aponta a câmera para o que está à sua frente. Nada é enviado nem gravado."
        }
      ],
      "./plugins/ios-build",
      "./plugins/ios-assinatura",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
