{
  "name": "@trainerkit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm audit:bundle",
    "preview": "vite preview --port 4273 --strictPort",
    "typecheck": "tsc --noEmit",
    "icons": "node --experimental-strip-types scripts/make-icons.ts",
    "test": "vitest run",
    "audit:bundle": "tsx scripts/audit-bundle.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@trainerkit/core": "workspace:*",
    "dexie": "^4.0.11",
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  }
}
